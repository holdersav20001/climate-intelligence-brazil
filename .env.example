# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=climate_intel
POSTGRES_PASSWORD=
POSTGRES_DB=climate_intel

# Paperclip reads this (connects to public schema — its internal tables)
DATABASE_URL=postgresql://climate_intel:CHANGE_ME@postgres:5432/climate_intel

# Our app reads this (connects to climate schema — articles, findings, contacts)
CLIMATE_DATABASE_URL=postgresql://climate_intel:CHANGE_ME@postgres:5432/climate_intel?options=-csearch_path%3Dclimate

# IMPORTANT: Replace CHANGE_ME above with the same value as POSTGRES_PASSWORD

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Paperclip ────────────────────────────────────────────────────────────────
PAPERCLIP_PUBLIC_URL=http://localhost:3100
BETTER_AUTH_SECRET=

# ── Claude / Agents ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── API ──────────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Auth ─────────────────────────────────────────────────────────────────────
AUTH_PROVIDER=local
# For Supabase (production):
# AUTH_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret
